# Modèle de configuration — copier vers .env et renseigner ses propres valeurs :
#   cp .env.example .env
# Le fichier .env réel est ignoré par Git (voir .gitignore) : ne jamais y mettre
# de secret dans .env.example.

# Nom d'utilisateur GitHub
GIT_USERNAME=

# Personal Access Token GitHub (PAS le mot de passe du compte).
# À générer : GitHub > Settings > Developer settings >
#             Personal access tokens > scope "repo".
GIT_PASSWORD=
