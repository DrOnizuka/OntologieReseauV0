# Exemples de requêtes SPARQL sur l'ontologie Réseau V0
# ------------------------------------------------------
# Charger dans le même dépôt (triplestore / Protégé « SPARQL Query ») :
#   - ontology/reseau-v0.ttl
#   - data/exemple-topologie.ttl
#
# Chaque requête est indépendante : copier/coller le PREFIX + la requête voulue.

PREFIX res:  <http://example.org/reseau/v0#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# =====================================================================
# Q1 — Lister tous les équipements avec leur type et leur site
# =====================================================================
SELECT ?equipement ?type ?nom ?site WHERE {
  ?equipement a ?type .
  ?type rdfs:subClassOf* res:Equipement .
  OPTIONAL { ?equipement res:nom ?nom }
  OPTIONAL { ?equipement res:localiseA ?site }
}
ORDER BY ?type

